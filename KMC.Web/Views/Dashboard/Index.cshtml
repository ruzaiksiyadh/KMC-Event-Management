@model List<EventViewModel>
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DashboardLayout";
    var totalRegistrations = Model.Sum(e => e.RegisteredCount);
    var totalCapacity = Model.Sum(e => e.Capacity);
    var upcoming = Model.Count(e => e.EventDate >= DateTime.Today);

    string IconFor(string type) => (type ?? "").Trim().ToLower() switch
    {
        "cultural" => "<path d=\"M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6\"/>",
        "music" => "<path d=\"M9 18V5l12-2v13\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><circle cx=\"18\" cy=\"16\" r=\"3\"/>",
        "sports" => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 3v18M3 12h18\"/>",
        "food" => "<path d=\"M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8Z\"/>",
        "business" => "<rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\"/><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"/>",
        "education" => "<path d=\"m22 10-10-5L2 10l10 5 10-5Z\"/><path d=\"M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5\"/>",
        "community" => "<path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75\"/>",
        "entertainment" => "<rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"m10 9 5 3-5 3V9Z\"/>",
        _ => "<path d=\"M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L4 3v5.59a2 2 0 0 0 .59 1.41l9.58 9.59a2 2 0 0 0 2.83 0l3.59-3.59a2 2 0 0 0 0-2.83Z\"/><circle cx=\"7.5\" cy=\"7.5\" r=\"1\"/>"
    };
}

<div class="dashboard-header">
    <div>
        <div class="sidebar-eyebrow">WORKSPACE OVERVIEW</div>
        <h1 class="mb-2">Dashboard</h1>
        <p class="hero-sub mb-0">Monitor your events, registrations, and capacity at a glance.</p>
    </div>
    <a asp-action="Create" class="btn-pill btn-pill-solid">+ New Event</a>
</div>

<div class="row g-3 mb-5">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Total events</div>
            <div class="stat-value">@Model.Count</div>
            <div class="stat-sub">@upcoming upcoming</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Registrations</div>
            <div class="stat-value">@totalRegistrations</div>
            <div class="stat-sub">of @totalCapacity total capacity</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-label">Avg. fill rate</div>
            <div class="stat-value">@(totalCapacity > 0 ? Math.Round((double)totalRegistrations / totalCapacity * 100) : 0)%</div>
            <div class="stat-sub">across all events</div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="section-label">Your events</div>
    <div class="empty-state">You haven't created any events yet.</div>
}
else
{
    <div class="events-panel">
        <div class="events-panel-header">
            <span class="events-panel-header-title">Your Events</span>
            <span class="events-panel-header-count">@Model.Count total</span>
        </div>

        @foreach (var ev in Model.OrderBy(e => e.EventDate))
        {
            var isUpcoming = ev.EventDate >= DateTime.Today;
            <div class="event-row">
                <div class="event-row-main">
                    <div class="event-row-title-line">
                        <span class="status-dot @(isUpcoming ? "upcoming" : "past")"></span>
                        <span class="event-row-title">@ev.Title</span>
                    </div>
                    <span class="event-row-sub">@ev.EventDate.ToString("dd MMM yyyy") &middot; @(isUpcoming ? "Upcoming" : "Past")</span>
                </div>

                <span class="type-pill">
                    <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">@Html.Raw(IconFor(ev.EventType))</svg>
                    @ev.EventType
                </span>

                <div class="event-row-registrations">
                    <strong>@ev.RegisteredCount / @ev.Capacity</strong>
                    registered
                </div>

                <div class="event-row-actions">
                    <a asp-action="Registrations" asp-route-id="@ev.Id" class="btn btn-outline-primary btn-sm">Registrations</a>
                    <a asp-action="Edit" asp-route-id="@ev.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                    <form asp-action="Delete" asp-route-id="@ev.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this event?');">
                        <button type="submit" class="btn btn-outline-primary btn-sm">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
