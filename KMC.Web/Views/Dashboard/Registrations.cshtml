@model List<RegistrationViewModel>
@{
    ViewData["Title"] = "Registrations";
    Layout = "_DashboardLayout";
}

<div class="dashboard-header">
    <div>
        <div class="sidebar-eyebrow">ORGANIZER</div>
        <h1 class="mb-2">Registrations</h1>
        <p class="hero-sub mb-0">Everyone registered for <strong>@ViewBag.EventTitle</strong>.</p>
    </div>
    <a asp-action="Index" class="btn-pill btn-pill-outline">&larr; Back to Dashboard</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">No one has registered for this event yet.</div>
}
else
{
    <div class="stat-card mb-4" style="max-width:260px;">
        <div class="stat-label">Total registered</div>
        <div class="stat-value">@Model.Count</div>
    </div>

    <div class="events-panel">
        <div class="events-panel-header">
            <span class="events-panel-header-title">Name / Email / Registered On</span>
            <span class="events-panel-header-count">@Model.Count total</span>
        </div>
        @foreach (var r in Model.OrderBy(r => r.RegisteredAt))
        {
            <div class="registration-row">
                <span class="registration-row-name">@r.ParticipantName</span>
                <span class="registration-row-email">@r.ParticipantEmail</span>
                <span class="registration-row-date">@r.RegisteredAt.ToString("dd MMM yyyy, h:mm tt")</span>
            </div>
        }
    </div>
}
