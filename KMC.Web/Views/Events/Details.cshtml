@model EventViewModel
@{
    ViewData["Title"] = Model.Title;

    string IconFor(string type) => (type ?? "").Trim().ToLower() switch
    {
        "cultural" => "<path d=\"M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6\"/>",
        "music" => "<path d=\"M9 18V5l12-2v13\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><circle cx=\"18\" cy=\"16\" r=\"3\"/>",
        "sports" => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 3v18M3 12h18\"/>",
        "food" => "<path d=\"M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8Z\"/>",
        "business" => "<rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\"/><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"/>",
        "education" => "<path d=\"m22 10-10-5L2 10l10 5 10-5Z\"/><path d=\"M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5\"/>",
        "community" => "<path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75\"/>",
        "entertainment" => "<rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"m10 9 5 3-5 3V9Z\"/>",
        _ => "<path d=\"M20.59 13.41 11 3.83A2 2 0 0 0 9.59 3.24L4 3v5.59a2 2 0 0 0 .59 1.41l9.58 9.59a2 2 0 0 0 2.83 0l3.59-3.59a2 2 0 0 0 0-2.83Z\"/><circle cx=\"7.5\" cy=\"7.5\" r=\"1\"/>"
    };
}

<div class="container content-wrap">
    @if (TempData["Message"] != null)
    {
        <div class="flash-message">@TempData["Message"]</div>
    }

    <a asp-action="Index" class="nav-link-mono d-inline-block mb-4">&larr; Back to all events</a>

    <div class="detail-card">
        <span class="event-type-tag">
            <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8">@Html.Raw(IconFor(Model.EventType))</svg>
            @Model.EventType
        </span>
        <h1 class="mb-2">@Model.Title</h1>
        <p class="event-meta">@Model.EventDate.ToString("dddd, dd MMMM yyyy") &middot; @Model.Location</p>
        <p class="card-text mb-4">@Model.Description</p>
        <p class="event-meta mb-1">Organized by @Model.OrganizerName</p>
        <p class="registered-count fw-bold">@Model.RegisteredCount / @Model.Capacity registered</p>

        @if (Model.Capacity > 0 && Model.RegisteredCount >= Model.Capacity)
        {
            <span class="btn-pill btn-pill-outline disabled">Event Full</span>
        }
        else
        {
            <a asp-action="Register" asp-route-id="@Model.Id" class="btn-pill btn-pill-solid">Register to attend</a>
        }
    </div>
</div>
