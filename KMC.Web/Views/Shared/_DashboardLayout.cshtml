<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="dashboard-shell">
        <aside class="dashboard-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-eyebrow">ORGANIZER</div>
                <div class="sidebar-title">@User.Identity?.Name</div>
                <div class="sidebar-tagline">Event management</div>
            </div>
            <a class="sidebar-nav-item active" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
            <a class="sidebar-nav-item" asp-controller="Dashboard" asp-action="Create">Create Event</a>
            <a class="sidebar-nav-item" asp-controller="Events" asp-action="Index">Public Site</a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="sidebar-nav-item" style="width:100%; text-align:left; background:none; border:none;">Log out</button>
            </form>
        </aside>
        <main class="dashboard-main">
            @if (TempData["Message"] != null)
            {
                <div class="flash-message">@TempData["Message"]</div>
            }
            @RenderBody()
        </main>
    </div>
</body>
</html>
