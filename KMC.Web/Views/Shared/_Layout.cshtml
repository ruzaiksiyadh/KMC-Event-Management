<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KMC Events</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="site-nav-float">
        <a class="nav-brand" asp-controller="Home" asp-action="Index">KMC EVENTS</a>
        <div class="nav-links-float d-none d-md-flex">
            <a class="nav-link-float" asp-controller="Home" asp-action="Index">Home</a>
            <a class="nav-link-float" asp-controller="Events" asp-action="Index">Explore Events</a>
            <a class="nav-link-float" asp-controller="Home" asp-action="Index">About</a>
            <a class="nav-link-float" href="mailto:events@kandymc.lk">Contact</a>
        </div>
        <div class="nav-actions-float">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="nav-link-float" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="nav-link-float" style="background:none;border:none;">Log out</button>
                </form>
                <a class="btn-pill btn-pill-solid" asp-controller="Dashboard" asp-action="Create">Create Event</a>
            }
            else
            {
                <a class="nav-link-float" asp-controller="Account" asp-action="Login">Login</a>
                <a class="btn-pill btn-pill-solid" asp-controller="Account" asp-action="Register">Create Event</a>
            }
        </div>
    </nav>

    @RenderBody()

    <footer class="footer-premium">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <p class="footer-brand">KMC EVENTS</p>
                    <p class="footer-tagline">Connecting Kandy through events and experiences.</p>
                    <div class="social-icons">
                        <a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
                        <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg></a>
                        <a href="#" aria-label="Twitter"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 4s-.7 2-2 3c1.4 8.6-7.4 14.4-15 10 2.7.2 5.4-.8 7-2.6-2.6-.1-4.8-1.8-5.6-4.2.9.2 1.7.1 2.5-.1C6 9.7 4.2 7.6 4.2 5c0 0 0-.1 0-.1 1 .6 2 .9 3.2 1C5.8 4.4 5.6 1.8 7 0c2.5 3 6.1 5 10.2 5.2C16.5 1.7 20.4.3 22.6 3.2c1.2-.2 2.3-.7 3.3-1.3-.4 1.2-1.2 2.2-2.2 2.9 1-.1 2-.4 2.9-.8-.6 1-1.5 1.9-2.4 2.6"/></svg></a>
                    </div>
                </div>
                <div class="col-md-2 offset-md-1">
                    <p class="footer-col-title">Platform</p>
                    <a class="footer-link" asp-controller="Events" asp-action="Index">Explore Events</a>
                    <a class="footer-link" asp-controller="Account" asp-action="Register">Organize an Event</a>
                </div>
                <div class="col-md-2">
                    <p class="footer-col-title">Company</p>
                    <a class="footer-link" asp-controller="Home" asp-action="Index">About</a>
                    <a class="footer-link" href="mailto:events@kandymc.lk">Contact</a>
                </div>
                <div class="col-md-3">
                    <p class="footer-col-title">Legal</p>
                    <a class="footer-link" href="#">Privacy Policy</a>
                    <a class="footer-link" href="#">Terms &amp; Conditions</a>
                </div>
            </div>
            <div class="footer-bottom">Kandy Municipal Council &nbsp;&middot;&nbsp; Community Event Platform</div>
        </div>
    </footer>

    <script src="~/js/site.js"></script>
</body>
</html>
